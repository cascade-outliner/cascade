# This is an example environment file for the Cascade project. Copy this file to .env and fill in the values as needed.

## Configuration for apps/website
DATABASE_URL_WEBSITE=postgres://user:password@localhost:5432/cascade-website
PAYLOAD_SECRET=replace-with-a-random-secret

## Configuration for apps/web-app (optional: without all of these the app stays fully local)
DATABASE_URL=postgres://user:password@localhost:5432/cascade
# Sign-in and sync: `openssl rand -base64 32` for the secret; the public URL of the app;
# a Google OAuth client with `<BETTER_AUTH_URL>/api/auth/callback/google` as a redirect URI.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## AI features in apps/web-app (optional: without it the AI features are disabled)
ANTHROPIC_API_KEY=

## Feature flags in apps/web-app (optional). Unset leaves a feature to the user's override or its default;
## `on`/`off` (also true/false, 1/0) pins it for everyone. Keys: apps/web-app/src/lib/feature-flags/registry.ts
# FEATURE_AI_SPLIT=
# FEATURE_SLASH_COMMANDS=
# FEATURE_DUE_ELSEWHERE=