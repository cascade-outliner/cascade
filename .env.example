# This is an example environment file for the Cascade project. Copy this file to .env and fill in the values as needed.

## Configuration for apps/website
DATABASE_URL_WEBSITE=postgres://user:password@localhost:5432/cascade-website
PAYLOAD_SECRET=replace-with-a-random-secret

## Configuration for apps/application
DATABASE_URL_APPLICATION=postgres://user:password@localhost:5432/cascade

## Configuration for packages/auth
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
