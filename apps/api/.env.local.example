# This app's own port. Kept distinct from apps/web-app (3001) and
# apps/website (3000) so all three can run side by side in dev.
PORT=3002

# Required — DatabaseModule fails to boot without it. Points at the same
# Postgres instance/database as apps/web-app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cascade

# Not read yet (src/modules/auth is still a placeholder). Session
# verification will reuse @cascade/auth's createAuth(), which needs the
# *same* secret apps/web-app signs cookies with — copy the value from
# apps/web-app/.env.local rather than generating a new one, or every
# session will look invalid here.
# BETTER_AUTH_SECRET=
