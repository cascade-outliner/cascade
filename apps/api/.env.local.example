DATABASE_URL=postgres://cascade:cascade@localhost:5432/cascade
BETTER_AUTH_SECRET=change-me-to-the-same-32-plus-character-secret-as-the-web-app
# Authentication endpoints remain on the web app.
BETTER_AUTH_URL=http://localhost:3001
# Production only: use the same value as the web app.
