{
  "name": "website",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "devsafe": "rm -rf dist && cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cascade/theme": "workspace:*",
    "@fontsource-variable/bitter": "^5.3.0",
    "@payloadcms/db-postgres": "4.0.0-canary.28",
    "@payloadcms/graphql": "4.0.0-canary.28",
    "@payloadcms/plugin-mcp": "4.0.0-canary.28",
    "@payloadcms/richtext-lexical": "4.0.0-canary.28",
    "@payloadcms/tanstack-start": "4.0.0-canary.28",
    "@payloadcms/ui": "4.0.0-canary.28",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-start": "^1.168.26",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "payload": "4.0.0-canary.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "srvx": "0.11.21",
    "tailwindcss": "^4.3.3",
    "vite": "8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "jsdom": "28.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
