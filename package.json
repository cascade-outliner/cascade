{
	"name": "cascade-monorepo",
	"private": true,
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "pnpm --filter @cascade/web-app dev & pnpm --filter @cascade/website dev",

		"web-app:dev": "pnpm --filter @cascade/web-app dev",
		"web-app:build": "pnpm --filter @cascade/web-app build",
		"web-app:start": "pnpm --filter @cascade/web-app start",
		"web-app:e2e": "pnpm --filter @cascade/web-app test:e2e",
		"web-app:e2e:ui": "pnpm --filter @cascade/web-app test:e2e:ui",

		"website:dev": "pnpm --filter @cascade/website dev",
		"website:build": "pnpm --filter @cascade/website build",
		"website:start": "pnpm --filter @cascade/website start",
		"website:seed": "pnpm --filter @cascade/website seed",
		"website:migrate": "pnpm --filter @cascade/website migrate",
		"website:migrate:create": "pnpm --filter @cascade/website migrate:create",
		"website:migrate:status": "pnpm --filter @cascade/website migrate:status",

		"db:generate": "pnpm --filter @cascade/db generate",
		"db:migrate": "pnpm --filter @cascade/db migrate",
		"db:studio": "pnpm --filter @cascade/db studio",

		"format": "biome format",
		"format:write": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"typecheck": "pnpm -r run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
