{
	"name": "cascade-monorepo",
	"private": true,
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "pnpm --filter @cascade/website --filter @cascade/web-app --parallel dev",

		"db:generate": "pnpm --filter @cascade/db generate",
		"db:migrate": "pnpm --filter @cascade/db migrate",
		"db:studio": "pnpm --filter @cascade/db studio",

		"format": "biome format",
		"format:write": "biome format --write",
		"lint": "biome lint",
		"check": "biome check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
